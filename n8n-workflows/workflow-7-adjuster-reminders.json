      ],
      "continueOnFail": true,
      "retryOnFail": true,
      "maxTries": 2,
      "waitBetweenTries": 2000
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{$vars.SUPABASE_URL}}/rest/v1/notifications",
        "sendHeaders": {
          "parameters": [
            {
              "name": "apikey",
              "value": "={{$vars.SUPABASE_SERVICE_ROLE_KEY}}"
            },
            {
              "name": "Authorization",
              "value": "=Bearer {{$vars.SUPABASE_SERVICE_ROLE_KEY}}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ {\"contractor_id\": $('Split Out 2h Claims').item.json.contractor_id, \"type\": \"adjuster_reminder\", \"title\": \"Adjuster meeting in 2 hours\", \"link_type\": \"claim\", \"link_id\": $('Split Out 2h Claims').item.json.id, \"channels_sent\": [\"in_app\", \"sms\"]} }}",
        "options": {}
      },
      "id": "insert-2h-notification",
      "name": "Insert 2h Notification",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [
        1120,
