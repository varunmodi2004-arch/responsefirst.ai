              "name": "From",
              "value": "={{$vars.TWILIO_ALERT_NUMBER}}"
            },
            {
              "name": "Body",
              "value": "=Reminder: adjuster meeting in about 2 hours{{$('Split Out 2h Claims').item.json.adjuster_name ? ' with ' + $('Split Out 2h Claims').item.json.adjuster_name : ''}}."
            }
          ]
        },
        "options": {}
      },
      "id": "send-2h-sms",
      "name": "Send 2h SMS",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [
        900,
