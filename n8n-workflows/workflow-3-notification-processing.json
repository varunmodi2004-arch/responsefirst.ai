    {
      "parameters": {
        "language": "javaScript",
        "jsCode": "// Unconditional send (per the original spec's Workflow 2 Step 6),\n// gated only on not having already sent \u2014 same idempotency\n// principle as the lead branch, just no value/urgency threshold.\nconst notification = $('Verify Internal Secret').item.json.record;\nconst claim = $('Fetch Claim').item.json[0];\nconst contractor = $('Fetch Contractor (claim)').item.json[0];\nconst alreadySent = (notification.channels_sent || []).includes('sms');\n\nreturn [{ json: {\n  shouldSendSms: !alreadySent,\n  contractorPhone: contractor?.phone,\n  messageBody: `Claim created for claim #${claim?.claim_number ?? claim?.id ?? ''}. Track it in your pipeline.`,\n  notificationId: notification.id,\n} }];"
      },
      "id": "compute-claim-sms-decision",
      "name": "Compute Claim SMS Decision",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
