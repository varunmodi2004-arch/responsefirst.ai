      "id": "notification-webhook",
      "name": "Notification Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        240,
        700
      ],
      "notes": "Fired by trg_notify_workflow3_new_notification (on notifications INSERT, not briefs INSERT \u2014 see the migration file for why). Payload: { record: {...full notifications row...} }. This row already has contractor_id, channels_sent, and link_id (the brief) \u2014 urgency/value/customer_id still need a Fetch Brief since those live on briefs, not notifications."
    },
    {
      "parameters": {
        "language": "javaScript",
        "jsCode": "const auth = $input.item.json.headers?.authorization || $input.item.json.headers?.Authorization || '';\nconst expected = `Bearer ${$env.INTERNAL_WEBHOOK_SECRET}`;\nconst verified = auth === expected;\nreturn [{ json: { ...$input.item.json.body, verified } }];"
      },
      "id": "verify-internal-secret",
      "name": "Verify Internal Secret",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        460,
        700
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "c1",
              "leftValue": "={{$json.verified}}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true"
              }
            }
          ],
          "combinator": "and"
        }
      },
      "id": "if-secret-verified",
      "name": "IF Secret Verified",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        680,
