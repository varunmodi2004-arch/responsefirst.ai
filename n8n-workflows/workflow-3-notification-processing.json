      "name": "Fetch Customer",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [
        1120,
        700
      ],
      "retryOnFail": true,
      "maxTries": 2,
      "waitBetweenTries": 1500
    },
    {
      "parameters": {
        "language": "javaScript",
        "jsCode": "const notification = $('Verify Internal Secret').item.json.record;\nconst brief = $('Fetch Brief').item.json[0];\nconst contractor = $('Fetch Contractor').item.json[0];\nconst customer = $('Fetch Customer').item.json[0];\nconst alreadySent = (notification.channels_sent || []).includes('sms');\nconst isHighValueOrUrgent = (brief.estimated_value_high >= 10000) || (brief.urgency === 'critical');\n\nreturn [{ json: {\n  shouldSendSms: !alreadySent && isHighValueOrUrgent,\n  contractorPhone: contractor?.phone,\n  messageBody: `New high-value lead: ${customer?.name || 'a homeowner'} \u2014 $${brief.estimated_value_low}-$${brief.estimated_value_high}. Check your dashboard.`,\n  notificationId: notification.id,\n} }];"
      },
      "id": "compute-lead-sms-decision",
      "name": "Compute Lead SMS Decision",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1340,
        700
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "should-send",
              "leftValue": "={{$json.shouldSendSms}}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true"
              }
            }
          ],
          "combinator": "and"
        }
      },
      "id": "if-should-send-sms",
      "name": "IF Should Send SMS",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        1450,
        700
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://api.twilio.com/2010-04-01/Accounts/{{$env.TWILIO_ACCOUNT_SID}}/Messages.json",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpBasicAuth",
        "sendBody": true,
        "specifyBody": "form-urlencoded",
        "bodyParameters": {
          "parameters": [
            {
              "name": "To",
              "value": "={{$json.contractorPhone}}"
            },
            {
              "name": "From",
              "value": "={{$env.TWILIO_ALERT_NUMBER}}"
            },
            {
              "name": "Body",
              "value": "={{$json.messageBody}}"
            }
          ]
        },
        "options": {}
      },
      "id": "send-sms-via-twilio",
      "name": "Send SMS via Twilio",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [
        1560,
        700
      ],
      "continueOnFail": true,
      "retryOnFail": true,
      "maxTries": 2,
      "waitBetweenTries": 2000,
      "notes": "continueOnFail=true is deliberate: the brief and notification are already committed by this point, so a Twilio failure (bad number, account issue) shouldn't roll anything back or error the whole run \u2014 it just means the contractor only gets the in-app notification, reflected below."
    },
    {
      "parameters": {
        "language": "javaScript",
        "jsCode": "// Runs after the Twilio node whether it succeeded or failed\n// (continueOnFail=true upstream). n8n surfaces a failed HTTP node's\n// result with an `error` field rather than throwing when\n// continueOnFail is set \u2014 check for that instead of assuming success.\nconst twilioResult = $json;\nconst smsSucceeded = !twilioResult.error && !!twilioResult.sid;\n\nreturn [{ json: {\n  notification_id: $('Verify Internal Secret').item.json.record.id,\n  channels_sent: smsSucceeded ? ['in_app', 'sms'] : ['in_app'],\n} }];"
      },
      "id": "determine-final-channels",
      "name": "Determine Final Channels",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1780,
        700
      ]
    },
